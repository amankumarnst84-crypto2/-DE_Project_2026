erDiagram
  cities {
    integer city_id PK
    text city_name
    text state
  }
  categories {
    integer category_id PK
    text category_name
    integer parent_id FK
  }
  boost_packages {
    integer package_id PK
    text package_name
    numeric price
    smallint duration_days
  }
  users {
    bigint user_id PK
    text full_name
    varchar phone
    text email
    integer city_id FK
    boolean phone_verified
    boolean is_banned
    timestamptz joined_at
  }
  listings {
    bigint listing_id PK
    bigint seller_id FK
    integer category_id FK
    text title
    text description
    numeric price
    boolean is_negotiable
    text item_condition
    jsonb attributes
    integer city_id FK
    text locality
    numeric latitude
    numeric longitude
    smallint image_count
    bigint view_count
    integer boost_package_id FK
    text status
    timestamptz posted_at
    timestamptz expires_at
    timestamptz sold_at
  }
  chat_threads {
    bigint thread_id PK
    bigint listing_id FK
    bigint buyer_id FK
    timestamptz created_at
  }
  chat_messages {
    bigint message_id PK
    bigint thread_id FK
    bigint sender_id FK
    text body
    timestamptz sent_at
    boolean is_read
  }
  offers {
    bigint offer_id PK
    bigint listing_id FK
    bigint buyer_id FK
    numeric offer_price
    text status
    timestamptz created_at
    timestamptz responded_at
  }
  favourites {
    bigint user_id PK,FK
    bigint listing_id PK,FK
    timestamptz saved_at
  }
  reports {
    bigint report_id PK
    bigint listing_id FK
    bigint reporter_id FK
    text reason
    timestamptz created_at
    text status
  }
  seller_ratings {
    bigint rating_id PK
    bigint seller_id FK
    bigint rater_id FK
    bigint listing_id FK
    smallint stars
    text comment
    timestamptz created_at
  }

digraph ER {
graph [rankdir=LR, bgcolor="#f8fafc", pad="0.4", nodesep="0.5", ranksep="1.1", splines=polyline, label="NEXORA T0138 — OLX DATABASE\nPK = primary key | FK = foreign key | edges: parent → child (0..many)\nChild has 1 parent unless marked 0..1. Full UNIQUE and CHECK constraints: sql/01_schema.sql", labelloc=t, fontname="Helvetica", fontsize=20];
